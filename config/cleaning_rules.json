{
  "rules_version": "v1.0",
  "minimum_clean_character_count": 500,
  "maximum_removed_ratio_without_review": 0.85,
  "maximum_consecutive_blank_lines": 1,
  "maximum_repeated_line_occurrences": 2,
  "generic": {
    "line_patterns": [
      {
        "name": "standalone_boolean",
        "pattern": "^\\s*(?:true|false)\\s*$",
        "flags": "IGNORECASE"
      },
      {
        "name": "long_numeric_identifier",
        "pattern": "^\\s*\\d{12,}\\s*$"
      },
      {
        "name": "empty_image",
        "pattern": "^\\s*!\\[[^\\]]*\\]\\(\\s*(?:[\"'][^\"']*[\"'])?\\s*\\)\\s*$"
      }
    ],
    "end_patterns": [],
    "navigation_noise_patterns": [
      "^\\s*\\[(?:跳至主內容|跳至主要內容)\\]",
      "^\\s*(?:主選單|Google 應用程式|清除搜尋內容|關閉搜尋)\\s*$"
    ],
    "footer_noise_patterns": [
      "^\\s*#\\s*支援小幫手\\s*$",
      "^\\s*搜尋說明中心\\s*$",
      "^\\s*返回頂端\\s*$"
    ]
  },
  "sites": {
    "support.google.com": {
      "end_patterns": [
        "^\\s*這個頁面可能含有使用 AI 技術翻譯的內容",
        "^\\s*##\\s*這對您有幫助嗎？\\s*$",
        "^\\s*##\\s*還有其他問題嗎？\\s*$",
        "^\\s*#\\s*支援小幫手\\s*$",
        "^\\s*搜尋說明中心\\s*$"
      ],
      "navigation_noise_patterns": [
        "^\\s*\\[跳至主內容\\]",
        "^\\s*Google 應用程式\\s*$"
      ],
      "footer_noise_patterns": [
        "這對您有幫助嗎",
        "還有其他問題嗎",
        "支援小幫手",
        "搜尋說明中心",
        "這個頁面可能含有使用 AI 技術翻譯的內容"
      ]
    },
    "www.gads.tw": {
      "end_patterns": [
        "^\\s*返回頂端\\s*$"
      ],
      "navigation_noise_patterns": [
        "^\\s*\\[跳至主要內容\\]",
        "^\\s*\\[首頁\\].*❭"
      ],
      "footer_noise_patterns": [
        "^\\s*返回頂端\\s*$"
      ]
    }
  }
}
