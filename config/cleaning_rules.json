{
  "rules_version": "v1.1",
  "minimum_clean_character_count": 500,
  "maximum_consecutive_blank_lines": 1,
  "generic": {
    "line_patterns": [
      {
        "name": "empty_image_without_url",
        "pattern": "^\\s*!\\[[^\\]]*\\]\\(\\s*(?:[\"'][^\"']*[\"'])?\\s*\\)\\s*$"
      }
    ],
    "navigation_noise_patterns": [
      "^\\s*\\[(?:跳至主內容|跳至主要內容)\\]",
      "^\\s*(?:主選單|Google 應用程式|清除搜尋內容|關閉搜尋)\\s*$"
    ],
    "footer_noise_patterns": [
      "^\\s*#\\s*支援小幫手\\s*$",
      "^\\s*搜尋說明中心\\s*$",
      "^\\s*返回頂端\\s*$"
    ]
  },
  "sites": {
    "support.google.com": {
      "navigation_noise_patterns": [
        "^\\s*\\[跳至主內容\\]",
        "^\\s*Google 應用程式\\s*$"
      ],
      "footer_noise_patterns": [
        "這對您有幫助嗎",
        "還有其他問題嗎",
        "支援小幫手",
        "搜尋說明中心",
        "這個頁面可能含有使用 AI 技術翻譯的內容"
      ]
    },
    "www.gads.tw": {
      "navigation_noise_patterns": [
        "^\\s*\\[跳至主要內容\\]",
        "^\\s*\\[首頁\\].*❭"
      ],
      "footer_noise_patterns": [
        "^\\s*返回頂端\\s*$"
      ]
    }
  }
}
